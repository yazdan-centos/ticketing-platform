# Copy this file to .env before starting the stack.
APP_PORT=8080
APP_IMAGE_TAG=latest

# Public GitHub repository cloned over HTTPS while building the AlmaLinux image.
SOURCE_REPOSITORY=https://github.com/yazdan-centos/ticketing-platform.git
SOURCE_BRANCH=main

FRONTEND_REPOSITORY=https://github.com/yazdan-centos/collaboration2.git
FRONTEND_BRANCH=main
# Public browser URL for the backend as exposed through Nginx.
REACT_APP_API_BASE_URL=http://localhost:8080

POSTGRES_DB=ticketing_platform_db
POSTGRES_USER=ticketing
POSTGRES_PASSWORD=change-this-database-password

# Must be a Base64-encoded secret of at least 32 bytes for HS256.
# Generate one with: openssl rand -base64 48
APP_JWT_SECRET=replace-with-a-generated-base64-secret

# Comma-separated Spring origin patterns.
APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*

JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -XX:+UseContainerSupport
